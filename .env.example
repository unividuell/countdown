# Local dev only — copy to `.env` (`cp .env.example .env`). NOT used in production.
# Stable host ports for local tooling (IntelliJ DB connection, pgAdmin).
# docker compose loads `.env` automatically (and so does Spring Boot's docker-compose
# support). Remove/comment a line to fall back to a random free port — see compose.yaml.
POSTGRES_PORT=15432
PGADMIN_PORT=15050

# Weltanschauung's Google credentials, read by the backend itself (see
# `spring.config.import` in core/src/main/resources/application.yaml). Empty is fine: the
# board then draws no map and no flags, everything else works. Create them in Cloud Console
# as described in core/README.md -- for local dev, restrict the browser key by HTTP referrer
# to `http://localhost:5173/*`, and give the server key API restrictions only.
SPOT_OBJECT_MAPS_API_KEY=
SPOT_OBJECT_SERVER_MAPS_API_KEY=
SPOT_OBJECT_SIGNING_SECRET=
