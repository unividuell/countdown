# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Stray compiled output
*.class

# macOS Finder metadata — no leading slash, so it matches at every depth
.DS_Store

# local dev env (ports only) — use .env.example as the template
.env
!.env.example

# superpowers brainstorming mockups
.superpowers/

# Klartext-Spielinhalte auf dem Weg zur SOPS-Verschlüsselung.
# Nie committen — auch nicht in Specs, Plänen oder Commit-Messages.
.local/

# update.sh entschluesselt das Guess-Hue-Datenset hierher (nur relevant, falls jemand
# update.sh lokal aus dem Repo-Checkout heraus testet -- auf dem Server ist es kein Git-Checkout).
deploy/secrets/
# Von update.sh heruntergeladene, noch verschluesselte Kopie (pro Target benannt, siehe
# update.sh) -- verschluesselt, also kein Leck, macht aber `git status` schmutzig. Der Stern
# verlangt einen Target-Infix, trifft also nicht deploy/guess-hue-dataset.sops.yaml selbst
# (Task 7s committete Datei ohne Infix bleibt getrackt).
deploy/guess-hue-dataset.*.sops.yaml
