{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd core && GITHUB_CLIENT_SECRET=unused-local-test-auth SUPER_ADMIN_GITHUB_LOGINS=bender ./mvnw spring-boot:run -Dspring-boot.run.arguments=--spring.docker.compose.file=../compose.yaml"
      ],
      "port": 8080
    },
    {
      "name": "webapp",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd webapp-vue && pnpm dev"],
      "port": 5173
    }
  ]
}
