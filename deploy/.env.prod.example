# Copy to .env.prod on the server. NEVER commit the real file.
COMPOSE_PROJECT_NAME=countdown
IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=production
PGADMIN_PORT=5050
BACKUP_DIR=./backups
POSTGRES_PASSWORD=change-me
GITHUB_CLIENT_SECRET=change-me
# comma-separated real GitHub logins granted the super-admin role; empty = nobody has it
SUPER_ADMIN_GITHUB_LOGINS=
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=change-me
# Wohin update.sh das entschluesselte Guess-Hue-Datenset legt (siehe compose.yaml core.volumes).
# Eigener Name pro Target -- prod und staging teilen sich dieses Verzeichnis.
GUESS_HUE_DATASET_FILE=./secrets/guess-hue-dataset.prod.yaml
# Optional. Nur setzen, wenn der private age-Schluessel nicht unter
# ~/.config/sops/age/keys.txt liegt. update.sh entschluesselt damit das Guess-Hue-Datenset.
# SOPS_AGE_KEY_FILE=/opt/unividuell/secrets/age.key
