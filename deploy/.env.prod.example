# Copy to .env.prod on the server. NEVER commit the real file.
COMPOSE_PROJECT_NAME=countdown
IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=production
PGADMIN_PORT=5050
BACKUP_DIR=./backups
POSTGRES_PASSWORD=change-me
GITHUB_CLIENT_SECRET=change-me
# comma-separated real GitHub logins granted the super-admin role; empty = nobody has it
SUPER_ADMIN_GITHUB_LOGINS=
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=change-me
# GUESS_HUE_DATASET_FILE wird NICHT hier gesetzt: update.sh berechnet und exportiert es selbst
# (siehe deploy/README.md) -- die Shell-Umgebung geht --env-file vor, ein Wert hier waere toter Text.
# SOPS_AGE_KEY_FILE gehoert NICHT hier hinein: update.sh liest diese Datei nur per --env-file an
# Compose weiter, sourced sie aber nie in die eigene Shell. Ein Wert hier erreicht also nie den
# sops-Aufruf in update.sh. Abweichender Schluesselort (Default ~/.config/sops/age/keys.txt) wird
# in der Umgebung gesetzt, in der update.sh laeuft, z.B.
# SOPS_AGE_KEY_FILE=/opt/unividuell/secrets/age.key ./update.sh prod
# (siehe deploy/README.md).
