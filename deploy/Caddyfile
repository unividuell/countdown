# Trust the shared edge (it reaches us over the private `edge` docker network) so this
# inner Caddy PRESERVES the edge's X-Forwarded-Proto=https / X-Forwarded-Host instead of
# overwriting them with the plaintext :80 hop. Without this, core builds an http:// OAuth
# redirect_uri (two-hop scheme loss).
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Backend paths. `/logout` is listed exact (the SPA POSTs to exactly /logout) AND as
	# `/logout/*`, because `path /logout/*` (slash before `*`) does NOT match the bare /logout.
	# `/login` is NOT listed exact on purpose: /login is the SPA's sign-in PAGE — only its
	# sub-paths (/login/github, /login/oauth2/code/*) are backend, so use `/login/*` only.
	@backend path /api/* /oauth2/* /login/* /logout /logout/*

	# API paths -> backend. A dedicated handle block (not a bare reverse_proxy) so it is
	# mutually exclusive with the SPA catch-all and evaluated first; otherwise the catch-all
	# handle matches everything (incl. /api/*) and the file_server swallows API requests.
	handle @backend {
		reverse_proxy core:8080 {
			# Caddy APPENDS to X-Forwarded-For, so its first entry may be the client's own
			# invention. {client_ip} is Caddy's own answer, honouring trusted_proxies, and
			# header_up replaces anything the client sent under this name.
			header_up X-Client-IP {client_ip}
		}
	}

	# Link previews. A crawler runs no JavaScript, so the SPA shell is a blank page to it — these
	# two conditions (crawler user agent AND a shareable path) send ONLY crawlers to core's
	# preview endpoint and leave every browser on the untouched SPA path below. If core is down,
	# the app still loads. `path /` is exact on purpose: `/*` would swallow the whole app.
	@preview {
		path / /c/* /join/*
		header_regexp User-Agent "(?i)(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|SkypeUriPreview|Applebot|redditbot|Googlebot|bingbot|Signal)"
	}

	handle @preview {
		rewrite * /api/preview{path}
		reverse_proxy core:8080 {
			header_up X-Client-IP {client_ip}
		}
	}

	# Vite's content-hashed build output: a changed file always gets a new URL, so it can be
	# cached forever. Its own handle block (not a `header @assets` matcher inside the SPA block)
	# keeps it mutually exclusive with the catch-all below: exactly one Cache-Control per
	# request, and NO try_files here — a missing hashed asset must 404 rather than fall back to
	# index.html, which would pin an HTML document under an asset URL for a year.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# everything else -> SPA with HTML5 history-mode fallback.
	# index.html is the unhashed entry point, so hashing cannot cover it: without an explicit
	# Cache-Control a browser applies RFC 9111 heuristic freshness and reuses the cached copy
	# without revalidating -> a tab open across a deploy keeps the old build (and, via the old
	# asset hashes, the whole old app) until a hard reload. `no-cache` means "revalidate before
	# use", not "don't store": with the ETag file_server already sends, that is a cheap 304.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
